---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Base title={frontmatter.title} description={frontmatter.description}><article class="post"><p class="eyebrow">Engineering notes · {frontmatter.date}</p><h1>{frontmatter.title}</h1><p class="lead">{frontmatter.description}</p><div class="post-body"><slot/></div><section class="comments"><h2>Discuss this article</h2><script src="https://utteranc.es/client.js" repo="adeelakhan/itsf9.dev" issue-term="pathname" label="comments" theme="github-light" crossorigin="anonymous" async is:inline></script></section></article><p class="section"><a href={`${base}writing/`}>All writing</a></p></Base>
