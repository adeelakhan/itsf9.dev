---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<Base title={frontmatter.title} description={frontmatter.description}><article class="post"><p class="eyebrow">Engineering notes · {frontmatter.date}</p><h1>{frontmatter.title}</h1><p class="lead">{frontmatter.description}</p><div class="post-body"><slot/></div></article><p class="section"><a href={`${base}writing/`}>All writing</a></p></Base>
